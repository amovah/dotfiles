command = /opt/homebrew/bin/fish --login
shell-integration = fish
macos-option-as-alt = true

# Installed by scripts/install-nerd-font.sh; four steps up from the default 13.
font-family = UbuntuMono Nerd Font
font-size = 17

# Let Option+arrows reach zellij as Alt+arrow (CSI 1;3C/D) instead of esc:f/esc:b,
# which zellij interpreted as "Alt f" -> ToggleFloatingPanes.
keybind = alt+arrow_left=unbind
keybind = alt+arrow_right=unbind
